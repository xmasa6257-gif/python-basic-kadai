        "# グローバルスコープの変数\n",
        "price1 = 100\n",
        "price2 = 200\n",
        "\n",
        "\n",
        "def total():\n",
        "    # ローカルスコープの変数（この関数の中だけで有効）\n",
        "    tax = 1.1\n",
        "    return (price1 + price2) * tax\n",
        "\n",
        "\n",
        "print(total())"
      ]
    }
